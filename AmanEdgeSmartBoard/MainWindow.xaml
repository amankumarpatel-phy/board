<Window x:Class="AmanEdgeSmartBoard.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AMAN EDGE SMARTBOARD" Height="850" Width="1440" MinHeight="600" MinWidth="900" WindowStartupLocation="CenterScreen" Background="#0B1220" PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#111D30" Padding="12">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock Text="AMAN EDGE" Foreground="White" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock Text="  SMARTBOARD" Foreground="#60A5FA" FontSize="19" FontWeight="Light" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="New" Click="New_Click"/><Button Content="Open" Click="Open_Click"/><Button Content="Save" Click="Save_Click"/><Button Content="Export PNG" Click="Export_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Background="#17253A" Padding="7">
      <WrapPanel VerticalAlignment="Center">
        <Button Content="✒ Pen" Click="Pen_Click"/><Button Content="Line" Click="Line_Click"/><Button Content="Rectangle" Click="Rectangle_Click"/><Button Content="Ellipse" Click="Ellipse_Click"/><Button Content="Arrow" Click="Arrow_Click"/><Button Content="Highlighter" Click="Highlighter_Click"/><Button Content="Select" Click="Select_Click"/><Button Content="Stroke Eraser" Click="StrokeEraser_Click"/><Button Content="Point Eraser" Click="PointEraser_Click"/>
        <TextBlock Text="  Colour" Foreground="White" VerticalAlignment="Center" Margin="12,0,3,0"/>
        <ComboBox x:Name="ColourBox" Width="105" SelectedIndex="0" SelectionChanged="Colour_Changed" Margin="3"><ComboBoxItem Content="White"/><ComboBoxItem Content="Black"/><ComboBoxItem Content="Red"/><ComboBoxItem Content="Blue"/><ComboBoxItem Content="Green"/><ComboBoxItem Content="Yellow"/></ComboBox>
        <TextBlock Text="Thickness" Foreground="White" VerticalAlignment="Center" Margin="12,0,3,0"/>
        <Slider x:Name="WidthSlider" Width="110" Minimum="1" Maximum="18" Value="3" ValueChanged="Width_Changed" VerticalAlignment="Center"/>
        <TextBlock x:Name="WidthLabel" Text="3 px" Foreground="White" VerticalAlignment="Center" Margin="4,0"/>
        <TextBlock Text="Background" Foreground="White" VerticalAlignment="Center" Margin="12,0,3,0"/>
        <ComboBox x:Name="BackgroundBox" Width="110" SelectedIndex="0" SelectionChanged="Background_Changed" Margin="3"><ComboBoxItem Content="Plain"/><ComboBoxItem Content="Grid"/><ComboBoxItem Content="Ruled"/><ComboBoxItem Content="Dots"/></ComboBox>
        <Button Content="Undo" Click="Undo_Click"/><Button Content="Redo" Click="Redo_Click"/><Button Content="Clear Page" Click="Clear_Click"/>
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#111D30" Padding="8">
      <DockPanel>
        <StackPanel Orientation="Horizontal"><Button Content="＋ Add Page" Click="AddPage_Click"/><Button Content="← Previous" Click="Previous_Click"/><Button Content="Next →" Click="Next_Click"/></StackPanel>
        <TextBlock x:Name="PageLabel" Text="Page 1 of 1" Foreground="#CBD5E1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </DockPanel>
    </Border>
    <Border Margin="12" CornerRadius="8" Background="#F8FAFC" ClipToBounds="True">
      <InkCanvas x:Name="Board" Background="White" EditingMode="Ink" UseLayoutRounding="True"/>
    </Border>
  </DockPanel>
</Window>
