<Application x:Class="AmanEdgeSmartBoard.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/>
      <Setter Property="Background" Value="#25334A"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Application.Resources>
</Application>
